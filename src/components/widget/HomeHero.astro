---
import { profileConfig, siteConfig } from "../../config";
---

<section id="home-hero" class="card-base relative overflow-hidden rounded-[var(--radius-large)] px-6 md:px-9 py-10 md:py-12 mb-4 onload-animation">
	<!-- 背景：品牌色光晕 + 细网格 -->
	<div aria-hidden="true" class="absolute inset-0 -z-10">
		<div class="absolute -top-24 -right-16 h-72 w-72 rounded-full bg-[oklch(0.75_0.14_var(--hue))] opacity-20 blur-3xl"></div>
		<div class="absolute -bottom-28 -left-16 h-64 w-64 rounded-full bg-[oklch(0.75_0.14_var(--hue))] opacity-10 blur-3xl"></div>
		<div class="absolute inset-0 [background-image:linear-gradient(var(--line-color)_1px,transparent_1px),linear-gradient(90deg,var(--line-color)_1px,transparent_1px)] [background-size:2rem_2rem] opacity-40"></div>
	</div>
	<h1 class="text-2xl md:text-4xl font-bold text-black/90 dark:text-white/90 mb-2">
		{siteConfig.title}
	</h1>
	<p class="text-black/60 dark:text-white/60 text-base md:text-lg mb-1">{siteConfig.subtitle}</p>
	<p class="text-sm text-black/50 dark:text-white/50">{profileConfig.bio}</p>
</section>
